{
  "name": "mensagem-immersive-web-starter-v4",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run generate:v4 && vite build",
    "preview": "vite preview",
    "server": "node --env-file=.env server/server.mjs",
    "audit": "node scripts/generate-v4-pages.mjs && node scripts/audit-architecture.mjs && node scripts/audit-demo.mjs && node scripts/audit-v4.mjs && node --check server/server.mjs && node --check demo-server.mjs",
    "check": "tsc --noEmit",
    "generate:v4": "node scripts/generate-v4-pages.mjs"
  },
  "dependencies": {
    "express": "5.2.1",
    "gsap": "3.15.0",
    "hls.js": "1.7.1",
    "howler": "2.2.4",
    "lenis": "1.3.26",
    "pdfjs-dist": "6.3.289",
    "three": "0.185.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/howler": "2.2.13",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
